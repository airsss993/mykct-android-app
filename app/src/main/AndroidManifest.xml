<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyKCT">

        <!-- Имя класса указано полностью: пакет исходников (ru.dzhaparidze.mykct)
             не совпадает с applicationId (ru.dzhaparidze.collegeapp), и относительное
             имя вида ".MainActivity" резолвилось бы в несуществующий класс. -->
        <activity
            android:name="ru.dzhaparidze.mykct.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyKCT">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Пуши FCM: приём в открытом приложении и смена токена (data/push/Push.kt) -->
        <service
            android:name="ru.dzhaparidze.mykct.data.push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Пуш в фоне рисует система: канал и иконка те же, что в PushService -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="schedule" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_calendar" />
    </application>

</manifest>
